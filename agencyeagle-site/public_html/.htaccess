# Force HTTPS and the bare domain.
RewriteEngine On
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://agencyeagle.com%{REQUEST_URI} [L,R=301]

# Old WordPress URLs.
RewriteRule ^new-website-pricing/?$ /pricing/ [L,R=301]
RewriteRule ^(wp-admin|wp-login\.php|wp-content|wp-includes|xmlrpc\.php|feed|blog)(/.*)?$ - [G,L]

ErrorDocument 404 /404.html
ErrorDocument 410 /404.html

# Security headers for the public site.
Header always set Strict-Transport-Security "max-age=31536000"
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "SAMEORIGIN"

Options -Indexes

# Deploy bookkeeping file.
<Files ".ftp-deploy-sync-state.json">
  Require all denied
</Files>
